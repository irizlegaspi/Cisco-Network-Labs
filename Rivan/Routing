@All Network Devices Basic Configuration: Change the Banner only
en
conf t
hostname PC1
enable secret pass
service password-encryption
! no logging console
no ip domain-lookup
!
line con 0
exec-timeout 0 0
password pass
login
exit
!
line vty 0 4
exec-timeout 0 0
password pass
login 
logging synchronous
exit
!
banner motd & --------------------- PC1 -------------------------- &
banner login & ------------------- BEWARE ------------------------ &
exit



